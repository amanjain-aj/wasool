# ---------------------------------------------------------------------------
# Wasool.io environment. Every block is optional: anything left blank falls
# back to local demo mode (seeded JSON store in .data/ + dry-run WhatsApp).
# ---------------------------------------------------------------------------

# Public base URL (used for WhatsApp button links -> /pay/{invoice_id})
APP_URL=http://localhost:3000

# --- Supabase (PostgreSQL). Run supabase/schema.sql first. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API (Graph v21.0) ---
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
META_TEMPLATE_LANGUAGE=en
# Verify token for the Meta delivery-status webhook (/api/webhooks/whatsapp)
META_WEBHOOK_VERIFY_TOKEN=

# --- Upstash QStash (daily 10:30 AM IST cron -> /api/cron/daily-dispatch) ---
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Alternative cron auth: send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Razorpay settlement webhook (/api/webhooks/razorpay) ---
RAZORPAY_WEBHOOK_SECRET=

# --- Dashboard protection (HTTP Basic auth on /dashboard and internal APIs) ---
# Strongly recommended whenever Supabase is configured.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
